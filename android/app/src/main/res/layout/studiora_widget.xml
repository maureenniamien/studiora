<?xml version="1.0" encoding="utf-8"?>
<!--
  BUGFIX (2026-09-12) : la mascotte était mal cadrée — combiner
  layout_weight (largeur en 0dp+poids) avec adjustViewBounds="true" est
  connu pour mal se comporter dans les widgets (RemoteViews) selon les
  lanceurs. On utilise maintenant scaleType="centerInside" (jamais
  d'étirement, l'image est simplement centrée et réduite si besoin) sur des
  ImageView en wrap_content, ce qui reste stable quelle que soit la taille
  du widget. On ajoute aussi un petit arbre (même esprit que l'Arbre de
  connaissance affiché dans l'app) à côté de la mascotte.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/studiora_widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_tree"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:scaleType="centerInside"
            android:contentDescription="Arbre de connaissance"
            android:src="@drawable/studiora_widget_tree" />

        <ImageView
            android:id="@+id/widget_mascot"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|bottom"
            android:scaleType="centerInside"
            android:contentDescription="Mascotte Studiora"
            android:src="@drawable/studiora_widget_mascot" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:orientation="vertical"
        android:paddingStart="10dp">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Studiora"
            android:textColor="#166534"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Chargement..."
            android:textColor="#3A3A3A"
            android:textSize="13sp"
            android:maxLines="4"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
